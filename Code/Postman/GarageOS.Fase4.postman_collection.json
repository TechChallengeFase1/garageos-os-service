            "url": {
              "raw": "{{baseUrl}}/billing/api/orcamentos?ordemDeServicoId={{osId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "billing",
                "api",
                "orcamentos"
              ],
              "query": [
                {
                  "key": "ordemDeServicoId",
                  "value": "{{osId}}"
