{
  "info": {
    "name": "GarageOS - Fase 4 (pelo API Gateway)",
    "description": "Fluxo ponta a ponta entre os três microsserviços, pelo API Gateway.\n\n1. Preencha as variáveis `baseUrl` (URL do API Gateway, sem barra no fim) e `adminPassword` (campo `adminPassword` do segredo `garageos/app/secrets`). Não salve a senha na coleção exportada.\n2. Rode as pastas em ordem. A saga é assíncrona: os passos que dependem dela esperam alguns segundos.\n3. Em `04 - Billing`, o último pedido mostra o link de pagamento no Console. Pague no navegador (conta compradora de teste, cartão do painel do Mercado Pago, titular APRO) antes da pasta 05.\n4. Para a compensação sem pagamento, rode 01, 02, 03 e depois `Cenário - cliente recusa`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "clienteToken",
      "value": ""
    },
    {
      "key": "cpf",
      "value": ""
    },
    {
      "key": "sufixo",
      "value": ""
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "veiculoId",
      "value": ""
    },
    {
      "key": "servicoId",
      "value": ""
    },
    {
      "key": "estoqueId",
      "value": ""
    },
    {
      "key": "osId",
      "value": ""
    },
    {
      "key": "numeroOS",
      "value": ""
    },
    {
      "key": "orcamentoId",
      "value": ""
    },
    {
      "key": "pagamentoId",
      "value": ""
    },
    {
      "key": "linkPagamento",
      "value": ""
    },
    {
      "key": "execucaoId",
      "value": ""
    },
    {
      "key": "itemId",
      "value": ""
    },
    {
      "key": "placa",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Autenticação",
      "description": "Token de Admin. O login é uma rota pública do gateway.",
      "item": [
        {
          "name": "POST Login de Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/os/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "os",
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Cadastros",
      "description": "Cliente, veículo e serviço no OS; peça no estoque do Execução.",
      "item": [
        {
          "name": "POST Cliente (OS)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/os/api/clientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "os",
                "api",
                "clientes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Cliente {{sufixo}}\",\n  \"documento\": \"{{cpf}}\",\n  \"email\": \"cliente{{sufixo}}@garageos.test\",\n  \"telefone\": \"119{{sufixo}}000\",\n  \"logradouro\": \"Rua das Flores\",\n  \"numero\": \"123\",\n  \"complemento\": \"\",\n  \"bairro\": \"Centro\",\n  \"cidade\": \"São Paulo\",\n  \"estado\": \"SP\",\n  \"cep\": \"01001000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// CPF válido e dados únicos a cada execução.",
                  "const n = Array.from({length: 9}, () => Math.floor(Math.random() * 10));",
                  "for (let k = 0; k < 2; k++) {",
                  "  const soma = n.reduce((s, d, i) => s + d * (n.length + 1 - i), 0);",
                  "  const dv = (soma * 10) % 11;",
                  "  n.push(dv === 10 ? 0 : dv);",
                  "}",
                  "pm.collectionVariables.set('cpf', n.join(''));",
                  "pm.collectionVariables.set('sufixo', String(Math.floor(10000 + Math.random() * 89999)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.expect(pm.response.code).to.be.oneOf([201]));",
                  "pm.collectionVariables.set('clienteId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Veículo (OS)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/os/api/veiculos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "os",
                "api",
                "veiculos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marcaVeiculo\": \"Volkswagen\",\n  \"modeloVeiculo\": \"Gol\",\n  \"placaVeiculo\": \"TST{{placa}}\",\n  \"anoVeiculo\": 2020,\n  \"precoVeiculo\": 30000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('placa', pm.collectionVariables.get('sufixo').slice(0, 4));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.expect(pm.response.code).to.be.oneOf([201]));",
                  "pm.collectionVariables.set('veiculoId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
