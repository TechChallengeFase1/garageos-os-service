            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/os/api/ordensdeservico/{{osId}}/orcamento/solicitar",
              "host": [
