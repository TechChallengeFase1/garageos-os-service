              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 202', () => pm.expect(pm.response.code).to.be.oneOf([202]));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Saga da OS",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/os/api/ordensdeservico/{{osId}}/saga",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "os",
                "api",
                "ordensdeservico",
                "{{osId}}",
                "saga"
              ]
            },
            "description": "O Billing gera o orçamento ao receber GerarOrcamento pela fila."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A saga é assíncrona: espera os outros serviços responderem pela fila.",
                  "setTimeout(() => {}, 5000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "const saga = pm.response.json();",
                  "pm.test('Saga em AguardandoOrcamento ou AguardandoAprovacao', () => pm.expect(saga.etapa).to.be.oneOf([\"AguardandoOrcamento\", \"AguardandoAprovacao\"]));",
                  "console.log('Etapa da saga:', saga.etapa, saga.motivo || '');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Billing: orçamento e cobrança",
      "description": "O cliente aprova, o Execução reserva as peças e o Billing abre a cobrança no Mercado Pago.",
      "item": [
