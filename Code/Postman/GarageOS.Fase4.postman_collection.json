            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/os/api/servicos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "os",
                "api",
                "servicos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeServico\": \"Revisão {{sufixo}}\",\n  \"preco\": 80.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.expect(pm.response.code).to.be.oneOf([201]));",
                  "pm.collectionVariables.set('servicoId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Peça no estoque (Execução)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/execucao/api/estoques",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "execucao",
                "api",
                "estoques"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Filtro {{sufixo}}\",\n  \"quantidade\": 10,\n  \"valor\": 10.0,\n  \"fornecedor\": \"Fornecedor Teste\",\n  \"dataEntrada\": \"{{$isoTimestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.expect(pm.response.code).to.be.oneOf([201]));",
