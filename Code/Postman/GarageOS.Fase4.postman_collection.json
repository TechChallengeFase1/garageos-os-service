      ]
    },
    {
      "name": "03 - Ordem de serviço e saga",
      "description": "Abre a OS e inicia a saga. O OS confere a peça no Execução por HTTP.",
      "item": [
        {
          "name": "POST Abertura completa (OS)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/os/api/ordensdeservico/abertura-completa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "os",
                "api",
                "ordensdeservico",
                "abertura-completa"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"veiculoId\": \"{{veiculoId}}\",\n  \"servicosIds\": [\n    \"{{servicoId}}\"\n  ],\n  \"pecas\": [\n    {\n      \"estoqueId\": \"{{estoqueId}}\",\n      \"quantidade\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.expect(pm.response.code).to.be.oneOf([201]));",
                  "const os = pm.response.json();",
                  "pm.collectionVariables.set('osId', os.id);",
                  "pm.collectionVariables.set('numeroOS', os.numeroOS);",
                  "console.log('OS:', os.numeroOS);"
                ]
              }
            }
          ]
        },
