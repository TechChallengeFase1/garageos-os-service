{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=GarageOS;Username=postgres"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "GarageOS@SuperSecretKey#2026!XpTo",
    "Issuer": "GarageOS.Api",
    "Audience": "GarageOS.Client",
    "ExpiresInMinutes": 60
  },
  "Servicos": {
    "Execucao": {
      "BaseUrl": "http://execucao.garageos-execucao.svc.cluster.local/"
    }
  },
  "Mensageria": {
    "Transporte": "AmazonSqs",
    "Ambiente": "producao",
    "Regiao": "us-east-1",
    "ServiceUrl": ""
  },
  "Saga": {
    "PrazoAprovacaoMinutos": 10,
    "PrazoPagamentoMinutos": 10
  },
  "Swagger": {
    "Enabled": false
  },
  "Admin": {
    "Username": "admin"
  }
}