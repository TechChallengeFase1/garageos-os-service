## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# SonarQube
.sonarqube/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml


# VISUAL STUDIO
.vs/
*.user
*.suo
bin/
obj/

# .claude configuration (keep in version control, except local settings that may contain tokens)
!.claude/
!.claude/**
!Code/.claude/
!Code/.claude/**
.claude/settings.local.json
Code/.claude/settings.local.json
.env
.env.*
!.env.example
appsettings.Development.json

# MCP config (contém tokens — não versionar)
.mcp.json
.mcp.json.*

# Editor / IDE
.vscode/
.idea/

# SonarLint (configuração local do analisador)
.sonarlint/

# Terraform da pasta infra/ (o state real vive no S3)
infra/.terraform/
infra/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan

# Gerado pelo Reqnroll no build
*.feature.cs

# Python
__pycache__/
